# AI Interviewer — Frontend
# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables (copy to .env.local for local development)
# ─────────────────────────────────────────────────────────────────────────────

# In local development, the Vite dev proxy handles /api and /ws routing to
# localhost:8000 automatically. These variables are only needed for production.

# Backend base URL (Render backend deployment URL)
# Used in production mode to bypass the dev proxy.
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# App Mode: "demo" or "production"
# Controls camera access, Whisper STT, ElevenLabs TTS on the client side.
VITE_APP_MODE=demo
